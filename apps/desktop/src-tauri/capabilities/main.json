{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local telemetry, limited exports and companion-window control for the bundled main application.",
  "windows": ["main"],
  "permissions": [
    "allow-telemetry-snapshot",
    "allow-datamine-bootstrap",
    "allow-datamine-check",
    "allow-export-json",
    "allow-native-smoke-complete",
    "allow-open-overlay",
    "allow-close-overlay",
    "allow-configure-overlay",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit",
    "core:event:allow-emit-to"
  ]
}
